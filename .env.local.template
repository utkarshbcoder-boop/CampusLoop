# ---------------------------------------------------------------------------
# CampusLoop Firebase Configuration
# ---------------------------------------------------------------------------
# 
# HOW TO GET THESE VALUES:
# 1. Go to https://console.firebase.google.com
# 2. Create a new project (or select existing)
# 3. Go to Project Settings > General > Your apps
# 4. Click "Add app" > Web (</>) and register
# 5. Copy the config values below
# 6. Enable Authentication > Google sign-in provider
# 7. Enable Firestore Database (Start in test mode)
# ---------------------------------------------------------------------------

# Set this to true to enable Firebase (real-time data for all users)
NEXT_PUBLIC_USE_FIREBASE=true

# Replace these with YOUR Firebase project config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
