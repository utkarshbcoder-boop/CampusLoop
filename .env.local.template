# ---------------------------------------------------------------------------
# CampusLoop Firebase Configuration
# ---------------------------------------------------------------------------
#
# HOW TO GET THESE VALUES:
#  1. Go to https://console.firebase.google.com
#  2. Create a new project (or select an existing one)
#  3. Go to Project Settings > General > Your apps
#  4. Click "Add app" > Web (</>) and register
#  5. Copy the config values below
#  6. Enable Authentication > Email/Password and Google sign-in providers
#  7. Create the Firestore Database (production mode, NOT test mode)
#  8. DEPLOY THE SECURITY RULES BEFORE ADDING ANY DATA:
#        firebase deploy --only firestore:rules
#        firebase deploy --only storage
#     A code deployment does NOT deploy these rules. Test mode leaves your
#     database world-writable for 30 days — never use it for real users.
#  9. Optional hardening for the /admin panel: set ADMIN_PANEL_PASSWORD
#     (server-side, below) so /admin requires a second password on top of
#     the Firebase admin check.
# ---------------------------------------------------------------------------

# Set this to true to enable Firebase (real-time data for all users)
NEXT_PUBLIC_USE_FIREBASE=true

# Replace these with YOUR Firebase project config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: second password gate for the /admin routes (defense in depth on
# top of the Firestore rules). Server-side only — never use NEXT_PUBLIC_ here.
# If unset, /admin relies on the Firebase admin check alone.
ADMIN_PANEL_PASSWORD=
