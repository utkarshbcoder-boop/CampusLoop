# ---------------------------------------------------------------------------
# CampusLoop environment
#
# The app runs with ZERO configuration. Every .env value below is OPTIONAL.
# With no env file present CampusLoop uses the seeded local data layer
# (`src/lib/db/mock.ts`) which mirrors the Supabase interface 1:1.
# ---------------------------------------------------------------------------

# Set to `true` to switch the data layer from the local mock to Supabase.
# When false/absent, the local seeded data layer is used regardless of the
# keys below. See README.md -> "Swapping to real Supabase".
NEXT_PUBLIC_USE_SUPABASE=false

# Supabase project (only needed when NEXT_PUBLIC_USE_SUPABASE=true)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Optional: OpenAI-backed match *enrichment*.
#
# The core matching engine is fully deterministic and needs no API key:
# see `src/lib/matching/engine.ts`. Set BOTH variables to opt in to an extra
# natural-language "why this match" pass on top of the deterministic score.
# If unset, the deterministic explanation is returned instead — no error.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
