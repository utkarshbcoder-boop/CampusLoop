    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.27",
    "playwright-core": "^1.63.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
