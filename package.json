{
  "name": "campusloop",
  "version": "1.0.0",
  "private": true,
  "description": "CampusLoop — Everything Students Need, Within Their Campus. A hyperlocal student ecosystem.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "rimraf .next",
    "build": "next build",
