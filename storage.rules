rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'utkarshbcoder@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /listing-images/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == ownerId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == ownerId);
    }
  }
}
